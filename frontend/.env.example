# Copy to .env.local for local development (.env.local is git-ignored).
# In production (Azure Static Web Apps) these come from the GitHub repo
# secrets used by .github/workflows/azure-static-web-apps-*.yml instead.

REACT_APP_API_URL=http://localhost:8000
REACT_APP_MS_CLIENT_ID=
REACT_APP_MS_TENANT_ID=
REACT_APP_REDIRECT_URI=

# ── Local-dev only — NEVER set these in production ──
# Skip Microsoft sign-in and look up this user_id in ops_QM.users instead.
# REACT_APP_DEV_USER_ID=you@quandatics.com
# Skip the backend user lookup too (synthetic admin user).
# REACT_APP_DEV_FAKE_USER=1
# Return fake data from src/services/mockApi.js instead of calling the backend.
# REACT_APP_DEV_MOCK_DATA=1
